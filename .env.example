# ==========================================
# 大模型配置 (OpenAI 兼容 API，支持第三方中转 / 本地 Ollama/vLLM)
# ==========================================
LLM_MODEL="填入你的模型名称，例如 grok-4-1-fast-non-reasoning"
LLM_API_KEY="填入你的 API KEY"
LLM_BASE_URL="https://api.shubiaobiao.cn/v1"

# 可选: RAG 向量检索用的 embedding 模型(中转站支持时填写，否则自动降级 BM25)
# EMBEDDING_MODEL="text-embedding-3-small"

# ==========================================
# GROMACS / gmx_MMPBSA 可执行文件
# ==========================================
# gmx 可执行文件(默认在 PATH; 也可写绝对路径)
GMX_BIN=/opt/gromacs/bin/gmx
# gmx_MMPBSA 可执行文件(MM/GBSA 结合能)
GMX_MMPBSA_BIN=/opt/gromacs/bin/gmx_MMPBSA
